# 豆绘AI平台 - 环境变量配置示例
# 复制此文件为 .env 并填写实际值

# ==================== 应用配置 ====================
APP_NAME="Douhuiai AI Platform"
ENVIRONMENT=development  # development / production / staging
DEBUG=True

# 密钥配置 (生产环境必须修改!!!)
SECRET_KEY=your-super-secret-key-change-this-in-production

# ==================== 数据库配置 ====================
POSTGRES_DB=douhuiai_db
POSTGRES_USER=douhuiai
POSTGRES_PASSWORD=douhuiai_password
POSTGRES_PORT=5432

# 数据库连接URL
DATABASE_URL=postgresql://douhuiai:douhuiai_password@localhost:5432/douhuiai_db

# ==================== Redis配置 ====================
REDIS_PASSWORD=redis123
REDIS_PORT=6379
REDIS_URL=redis://:redis123@localhost:6379/0

# ==================== Celery配置 ====================
CELERY_BROKER_URL=redis://:redis123@localhost:6379/1
CELERY_RESULT_BACKEND=redis://:redis123@localhost:6379/2

# ==================== JWT配置 ====================
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
ALGORITHM=HS256

# ==================== CORS配置 ====================
# 允许的跨域源,多个用逗号分隔
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:8080

# ==================== 豆绘AI API配置 ====================
# 豆绘AI API 地址（固定，勿修改）
DOUHUIAI_API_URL=https://dhd.douhuiai.com
# AppID 和 AppSecret（在豆绘AI开放平台获取，必填）
DOUHUIAI_APP_ID=your-app-id-here
DOUHUIAI_APP_SECRET=your-app-secret-here
# 生成图片CDN前缀（固定，勿修改）
DOUHUIAI_IMG_BASE_URL=https://img2.douhuiai.com/dhimg/

# ==================== 前端配置 ====================
VITE_API_BASE_URL=http://localhost:8000
FRONTEND_PORT=3000

# ==================== 后端配置 ====================
BACKEND_PORT=8000

# ==================== 日志配置 ====================
LOG_LEVEL=INFO  # DEBUG / INFO / WARNING / ERROR / CRITICAL

# ==================== 文件上传配置 ====================
MAX_UPLOAD_SIZE=10485760  # 10MB in bytes
UPLOAD_DIR=./uploads

# ==================== 配额配置 ====================
# 新用户注册赠送配额
NEW_USER_QUOTA=10.00
# 最小充值金额
MIN_RECHARGE_AMOUNT=10.00

# ==================== 邮件配置 (可选) ====================
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-email-password
SMTP_FROM=noreply@douhuiai.com

# ==================== 监控配置 (可选) ====================
# Sentry DSN for error tracking
SENTRY_DSN=

# Prometheus metrics
ENABLE_METRICS=False

# ==================== 生产环境额外配置 ====================
# Nginx配置
NGINX_HTTP_PORT=80
NGINX_HTTPS_PORT=443

# SSL证书路径
SSL_CERT_PATH=/etc/nginx/ssl/cert.pem
SSL_KEY_PATH=/etc/nginx/ssl/key.pem

# 备份配置
BACKUP_ENABLED=True
BACKUP_SCHEDULE="0 2 * * *"  # 每天凌晨2点
BACKUP_RETENTION_DAYS=7

# ==================== 开发配置 ====================
# 热重载
HOT_RELOAD=True

# 数据库自动迁移
AUTO_MIGRATE=True

# API文档
ENABLE_API_DOCS=True

# ==================== 速率限制 ====================
RATE_LIMIT_ENABLED=True
RATE_LIMIT_PER_MINUTE=60
RATE_LIMIT_PER_HOUR=1000
