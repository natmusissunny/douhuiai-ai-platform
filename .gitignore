.env.local
.env.*.local

# 日志文件
*.log
logs/

# 操作系统
.DS_Store
Thumbs.db
desktop.ini

# IDE / 编辑器
.vscode/
.idea/
*.swp
*.swo
*~
.project
.classpath
.settings/

# ==================== Python / Backend ====================

# Python缓存
__pycache__/
*.py[cod]
*$py.class
*.so

# 虚拟环境
venv/
env/
ENV/
backend/venv/
backend/env/

# pytest
.pytest_cache/
.coverage
htmlcov/
.tox/

# mypy
.mypy_cache/
.dmypy.json

# 分发/打包
dist/
build/
*.egg-info/
*.egg

# Jupyter Notebook
.ipynb_checkpoints

# ==================== Node.js / Frontend ====================

# 依赖
node_modules/
frontend/node_modules/

# 构建输出
frontend/dist/
frontend/build/

# 缓存
.cache/
.parcel-cache/
.turbo/

# npm/yarn
npm-debug.log*
yarn-debug.log*
yarn-error.log*
package-lock.json
yarn.lock

# ==================== Docker ====================

# Docker卷数据（由docker-compose管理）
postgres_data/
redis_data/

# ==================== 备份和临时文件 ====================

# 备份文件
backups/*.sql
backups/*.sql.gz
backups/*.dump

# 上传文件
uploads/
backend/uploads/

# 临时文件
*.tmp
*.temp
.tmp/

# ==================== 数据库 ====================

# SQLite (如果使用)
*.db
*.sqlite
*.sqlite3

# ==================== 敏感信息 ====================

# 密钥和证书
